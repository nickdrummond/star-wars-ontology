     owl:someValuesFrom :Dalgo
    ] ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :used ;
     owl:someValuesFrom :Nu-class_shuttle
    ] ;
 :after :Onderon_rebels_ask_for_support ;
