 :at :Onderon ;
 :during :Onderon_Civil_War ;
 :of :Ahsoka_Tano ,
  :Anakin_Skywalker ,
  :Obi-Wan_Kenobi ,
  :Rex ;
 :participant :Steela_Gerrera ;
 :year -20 ;
 rdfs:label "Arrival on Onderon"@en ;
 rdfs:seeAlso "https://starwars.fandom.com/wiki/A_War_on_Two_Fronts"^^xsd:anyURI ;
 util:editorLabel "Arrival_on_Onderon" ;
 util:legacyId "-1729815376" .


:Attack_on_Hondos_base rdf:type owl:NamedIndividual ,
  :Attack ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :included ;
     owl:someValuesFrom [ owl:intersectionOf ( :Arrival
             [ rdf:type owl:Restriction ;
                owl:onProperty :used ;
                owl:someValuesFrom :Eta-class_shuttle
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Adi_Gallia
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Obi-Wan_Kenobi
               ]
            ) ;
         rdf:type owl:Class
        ]
    ] ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :included ;
     owl:someValuesFrom [ owl:intersectionOf ( :Duel
             [ rdf:type owl:Restriction ;
                owl:onProperty :participant ;
                owl:hasValue :Maul
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :participant ;
                owl:hasValue :Obi-Wan_Kenobi
               ]
            ) ;
         rdf:type owl:Class
        ]
    ] ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :included ;
     owl:someValuesFrom [ owl:intersectionOf ( :Killing
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Adi_Gallia
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :participant ;
                owl:hasValue :Savage_Opress
               ]
            ) ;
         rdf:type owl:Class
        ]
    ] ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :included ;
     owl:someValuesFrom [ owl:intersectionOf ( :Retreat
             [ rdf:type owl:Restriction ;
                owl:onProperty :at ;
                owl:someValuesFrom :Tunnel
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Hondo_Ohnaka
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Obi-Wan_Kenobi
               ]
            ) ;
         rdf:type owl:Class
        ]
    ] ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :used ;
     owl:someValuesFrom :Flarestar-class_attack_shuttle
    ] ;
 :at :Hondos_complex ;
 :during :Battle_of_Florrum ;
 :year -19 ;
 rdfs:label "Attack on Hondos base"@en ;
 rdfs:seeAlso "https://starwars.fandom.com/wiki/Revival_(episode)"^^xsd:anyURI ;
