:Ahsoka_takes_on_the_pirates rdf:type owl:NamedIndividual ,
  :Fight ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :included ;
     owl:someValuesFrom [ owl:intersectionOf ( :Ejection
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Ahsoka_Tano
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Hondo_Ohnaka
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Ohnaka_Gang
               ]
            ) ;
         rdf:type owl:Class
        ]
    ] ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :included ;
     owl:someValuesFrom [ owl:intersectionOf ( :Escape
             [ rdf:type owl:Restriction ;
                owl:onProperty :of ;
                owl:hasValue :Crucible
               ]
            ) ;
         rdf:type owl:Class
        ]
    ] ,
  [ rdf:type owl:Restriction ;
     owl:onProperty :included ;
     owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                owl:onProperty :activated ;
                owl:someValuesFrom :Engine
               ]
             [ rdf:type owl:Restriction ;
                owl:onProperty :participant ;
                owl:hasValue :Zatt
               ]
            ) ;
         rdf:type owl:Class
        ]
    ] ;
 :after :Pirates_find_the_younglings ;
 :at :Crucible ;
 :during :Return_to_Coruscant_from_Ilum ;
 :participant :Ahsoka_Tano ,
  :Hondo_Ohnaka ,
  :Ohnaka_Gang ;
 :year -20 ;
 rdfs:label "Ahsoka takes on the pirates"@en ;
 rdfs:seeAlso "https://starwars.fandom.com/wiki/A_Test_of_Strength"^^xsd:anyURI ;
 util:editorLabel "Ahsoka_takes_on_the_pirates" ;
