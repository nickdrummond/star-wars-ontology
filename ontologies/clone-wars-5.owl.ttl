 rdfs:seeAlso "https://nickdrummond.github.io/star-wars-ontology/"^^xsd:anyURI ,
  "https://starwars.fandom.com/wiki/The_Clone_Wars:_Season_Five"^^xsd:anyURI .

:Arrival_on_Onderon rdf:type owl:NamedIndividual ,
  :Arrival ,
  [ rdf:type owl:Restriction ;
